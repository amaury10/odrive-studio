<Window x:Class="ODriveStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ODriveStudio.App.Views"
        Title="ODrive Studio" Width="1280" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackground}"
        PreviewKeyDown="OnPreviewKeyDown">
    <DockPanel>
        <!-- Bandeau : choix de la carte et arrêt d'urgence, toujours visibles. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBackground}" Padding="12,8">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Command="{Binding EmergencyStopCommand}" Margin="12,0,0,0"
                        Background="{StaticResource Danger}" Foreground="White" BorderBrush="#7F1D1D"
                        FontWeight="Bold" FontSize="15" Padding="18,8" Cursor="Hand"
                        ToolTip="Passe tous les axes de toutes les cartes en IDLE (touche Échap)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="5"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#E53935" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#8E1B1B" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    ARRÊT D'URGENCE (Échap)
                </Button>
                <TextBlock DockPanel.Dock="Left" Text="ODrive Studio" Foreground="White" FontSize="18"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0" />
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="Title" VerticalAlignment="Center" MinWidth="360"
                          HorizontalAlignment="Left" Padding="8,5"
                          Visibility="{Binding HasDevice, Converter={StaticResource BoolToVisibility}}" />
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Padding="6,2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <TabControl SelectedIndex="{Binding SelectedTabIndex}" Margin="6" Padding="4">
            <TabItem Header="Tableau de bord" Padding="14,6">
                <Grid>
                    <ContentControl Content="{Binding SelectedDevice.Dashboard}"
                                    Visibility="{Binding HasDevice, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760"
                                Visibility="{Binding HasDevice, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="{Binding ConnectionHint}" TextWrapping="Wrap" FontSize="15"
                                   TextAlignment="Center" Foreground="{StaticResource MutedText}" />
                        <Button Content="Corriger (droits administrateur)…" Command="{Binding RepairUsbCommand}"
                                HorizontalAlignment="Center" Margin="0,16,0,0" Padding="16,6"
                                Visibility="{Binding CanRepairUsb, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Explorateur" Padding="14,6">
                <Grid>
                    <ContentControl Content="{Binding SelectedDevice.Explorer}"
                                    Visibility="{Binding HasDevice, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760"
                                Visibility="{Binding HasDevice, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="{Binding ConnectionHint}" TextWrapping="Wrap" FontSize="15"
                                   TextAlignment="Center" Foreground="{StaticResource MutedText}" />
                        <Button Content="Corriger (droits administrateur)…" Command="{Binding RepairUsbCommand}"
                                HorizontalAlignment="Center" Margin="0,16,0,0" Padding="16,6"
                                Visibility="{Binding CanRepairUsb, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Mise en service" Padding="14,6">
                <Grid>
                    <ContentControl Content="{Binding SelectedDevice.Commissioning}"
                                    Visibility="{Binding HasDevice, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="Aucune carte ODrive connectée." FontSize="15" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedText}"
                               Visibility="{Binding HasDevice, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>
            </TabItem>
            <TabItem Header="Essai moteur" Padding="14,6">
                <Grid>
                    <ContentControl Content="{Binding SelectedDevice.Jog}"
                                    Visibility="{Binding HasDevice, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="Aucune carte ODrive connectée." FontSize="15" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedText}"
                               Visibility="{Binding HasDevice, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>
            </TabItem>
            <TabItem Header="Autotune" Padding="14,6">
                <Grid>
                    <ContentControl Content="{Binding SelectedDevice.Autotune}"
                                    Visibility="{Binding HasDevice, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="Aucune carte ODrive connectée." FontSize="15" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedText}"
                               Visibility="{Binding HasDevice, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>
            </TabItem>
            <TabItem Header="Profils" Padding="14,6">
                <Grid>
                    <ContentControl Content="{Binding SelectedDevice.Profiles}"
                                    Visibility="{Binding HasDevice, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="Aucune carte ODrive connectée." FontSize="15" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedText}"
                               Visibility="{Binding HasDevice, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>
            </TabItem>
            <TabItem Header="Firmware" Padding="14,6">
                <views:FirmwareView DataContext="{Binding Firmware}" />
            </TabItem>
            <TabItem Header="Journal" Padding="14,6">
                <DockPanel Margin="6">
                    <DockPanel DockPanel.Dock="Top" Margin="0,4,0,8" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource MutedText}"
                                   Text="Toutes les écritures et tous les appels de fonction faits par l'outil pendant cette session." />
                        <Button DockPanel.Dock="Right" Content="Exporter en CSV…" Command="{Binding ExportJournalCommand}" Margin="0" />
                    </DockPanel>
                    <!-- Messages et erreurs -->
                    <DockPanel DockPanel.Dock="Bottom" Height="230" Margin="0,8,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource MutedText}"
                                       Text="Messages et erreurs de la barre d'état depuis le lancement." />
                            <Button DockPanel.Dock="Right" Content="Copier les messages" Command="{Binding CopyMessagesCommand}" Margin="0" />
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Messages}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource CardBorder}" RowHeaderWidth="0"
                                  FontFamily="Consolas" FontSize="13" SelectionMode="Extended" ClipboardCopyMode="ExcludeHeader">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Heure" Binding="{Binding Time}" Width="80" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Text}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Journal}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource CardBorder}" RowHeaderWidth="0"
                              FontFamily="Consolas" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Heure" Binding="{Binding Time}" Width="110" />
                            <DataGridTextColumn Header="Carte" Binding="{Binding Board}" Width="130" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="80" />
                            <DataGridTextColumn Header="Chemin" Binding="{Binding Path}" Width="2*" />
                            <DataGridTextColumn Header="Ancienne valeur" Binding="{Binding OldValue}" Width="*" />
                            <DataGridTextColumn Header="Nouvelle valeur" Binding="{Binding NewValue}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
