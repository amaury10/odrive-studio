<UserControl x:Class="ODriveStudio.App.Views.CommissioningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Choix et avancement -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Moteur roue d'hoverboard" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Axe" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Axes}" SelectedItem="{Binding Axis}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Text="Kv (tr/min par volt)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Kv, UpdateSourceTrigger=LostFocus}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Text="Paires de pôles (aimants / 2)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PolePairs, UpdateSourceTrigger=LostFocus}" Margin="0,2" />
                            <TextBlock Grid.Row="3" Text="Résistance de freinage branchée" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding BrakeResistorConnected}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="4" Text="Résistance de freinage (Ω)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding BrakeResistance, UpdateSourceTrigger=LostFocus}" Margin="0,2" />
                            <TextBlock Grid.Row="5" Text="Recharge acceptée par l'alimentation (A)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding RegenCurrent, UpdateSourceTrigger=LostFocus}" Margin="0,2" />
                            <TextBlock Grid.Row="6" Text="Limite de courant (A)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding CurrentLimit, UpdateSourceTrigger=LostFocus}" Margin="0,2" />
                            <TextBlock Grid.Row="7" Text="Limite de vitesse (tours/s)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding VelocityLimit, UpdateSourceTrigger=LostFocus}" Margin="0,2" />
                            <TextBlock Grid.Row="8" Text="Rampe de vitesse (tours/s²)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding VelocityRampRate, UpdateSourceTrigger=LostFocus}" Margin="0,2" />
                            <TextBlock Grid.Row="9" Text="Watchdog (contrôleur CAN)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="9" Grid.Column="1" IsChecked="{Binding EnableWatchdog}" VerticalAlignment="Center" />
                        </Grid>
                        <Button Content="Proposer les valeurs" Command="{Binding ProposeCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding SupplyWarning}" Foreground="{StaticResource Armed}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding OptionsMessage}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Avancement" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Checklist}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" Margin="0,3">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource MutedText}"
                                   Text="Ensuite : onglet « Essai moteur » pour faire tourner la roue, puis sauvegarder." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Valeurs, actions, compte rendu -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                <StackPanel>
                    <WrapPanel>
                        <Button Content="Écrire dans la carte" Command="{Binding ApplyCommand}" Margin="0,0,8,6" />
                        <Button Content="Sauvegarder et redémarrer…" Command="{Binding SaveAndRebootCommand}" Margin="0,0,8,6" />
                        <Button Content="Exporter le profil…" Command="{Binding ExportProfileCommand}" Margin="0,0,8,6" />
                    </WrapPanel>
                    <TextBlock Text="Des réglages écrits ne prennent effet qu'après « Sauvegarder et redémarrer »."
                               Foreground="{StaticResource Armed}" FontWeight="SemiBold" Margin="0,0,0,6"
                               Visibility="{Binding RebootNeeded, Converter={StaticResource BoolToVisibility}}" />
                    <WrapPanel>
                        <Button Content="Calibration complète" Command="{Binding RunCalibrationCommand}" CommandParameter="full" Margin="0,0,8,6" FontWeight="SemiBold" />
                        <Button Content="Moteur seul" Command="{Binding RunCalibrationCommand}" CommandParameter="motor" Margin="0,0,8,6" />
                        <Button Content="Polarité Hall seule" Command="{Binding RunCalibrationCommand}" CommandParameter="hall" Margin="0,0,8,6" />
                        <Button Content="Offset capteur seul" Command="{Binding RunCalibrationCommand}" CommandParameter="offset" Margin="0,0,8,6" />
                        <Button Content="Annuler la calibration" Command="{Binding CancelCalibrationCommand}" Margin="0,0,8,6" />
                    </WrapPanel>
                    <TextBlock Text="{Binding CalibrationState}" Foreground="{StaticResource Armed}" FontWeight="SemiBold" />
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="Mémoriser la calibration (pre__calibrated)" Command="{Binding MarkPreCalibratedCommand}" Margin="0,0,12,0" />
                        <CheckBox IsChecked="{Binding StartupClosedLoop}" VerticalAlignment="Center"
                                  Content="Démarrer en boucle fermée à la mise sous tension" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <ListBox DockPanel.Dock="Bottom" ItemsSource="{Binding Log}" Height="130" FontFamily="Consolas" FontSize="13"
                     Margin="6,0,6,6" BorderBrush="{StaticResource CardBorder}" />

            <DataGrid ItemsSource="{Binding Settings}" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource CardBorder}" RowHeaderWidth="0" Margin="6" FontSize="13">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDifferent}" Value="True">
                                <Setter Property="Background" Value="#FFF8E1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Étape" Binding="{Binding StepName}" IsReadOnly="True" Width="115" />
                    <DataGridTextColumn Header="Réglage" Binding="{Binding Label}" IsReadOnly="True" Width="250" />
                    <DataGridTemplateColumn Header="Valeur à écrire" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"
                                         BorderThickness="0" Background="Transparent" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Unité" Binding="{Binding Unit}" IsReadOnly="True" Width="95" />
                    <DataGridTextColumn Header="Dans la carte" Binding="{Binding CurrentValue}" IsReadOnly="True" Width="120" FontFamily="Consolas" />
                    <DataGridTextColumn Header="Remarque" Binding="{Binding Note}" IsReadOnly="True" Width="330" />
                    <DataGridTextColumn Header="Erreur" Binding="{Binding Message}" IsReadOnly="True" Width="160" Foreground="{StaticResource Danger}" />
                    <DataGridTextColumn Header="Chemin" Binding="{Binding Path}" IsReadOnly="True" Width="330" FontFamily="Consolas" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
