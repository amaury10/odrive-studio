<UserControl x:Class="ODriveStudio.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="6">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Profils de configuration" Style="{StaticResource CardTitle}" />
                <TextBlock TextWrapping="Wrap" Margin="0,6,0,10" Foreground="{StaticResource MutedText}"
                           Text="Un profil contient tous les réglages persistants de la carte et de ses deux axes. Charger un profil ne modifie rien : il liste les écarts avec la carte, et seuls les écarts cochés sont écrits." />
                <WrapPanel>
                    <Button Content="Exporter la carte…" Command="{Binding ExportCommand}" Margin="0,0,8,6" />
                    <Button Content="Charger un profil…" Command="{Binding ImportCommand}" Margin="0,0,8,6" />
                    <Button Content="Recomparer" Command="{Binding CompareCommand}" Margin="0,0,8,6" />
                    <Button Content="Tout cocher" Command="{Binding SelectAllCommand}" Margin="0,0,8,6" />
                    <Button Content="Tout décocher" Command="{Binding SelectNoneCommand}" Margin="0,0,8,6" />
                    <Button Content="Écrire les écarts cochés dans la carte…" Command="{Binding ApplySelectedCommand}"
                            FontWeight="SemiBold" Margin="0,0,8,6" />
                </WrapPanel>
                <TextBlock Text="{Binding ProfileSummary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{StaticResource Danger}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Differences}" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource CardBorder}" RowHeaderWidth="0" Margin="6"
                  FontFamily="Consolas" FontSize="13">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Écrire" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanApply}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Chemin" Binding="{Binding Path}" IsReadOnly="True" Width="3*" />
                <DataGridTextColumn Header="Profil" Binding="{Binding ProfileValue}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="Carte" Binding="{Binding DeviceValue}" IsReadOnly="True" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
