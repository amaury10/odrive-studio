<UserControl x:Class="ODriveStudio.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Bus et commandes de la carte -->
            <Border Style="{StaticResource Card}">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <StackPanel Margin="0,0,36,0">
                            <TextBlock Text="Tension du bus" Style="{StaticResource FieldLabel}" Margin="0" />
                            <TextBlock Text="{Binding BusVoltage}" FontFamily="Consolas" FontSize="22" />
                        </StackPanel>
                        <StackPanel Margin="0,0,36,0">
                            <TextBlock Text="Courant du bus" Style="{StaticResource FieldLabel}" Margin="0" />
                            <TextBlock Text="{Binding BusCurrent}" FontFamily="Consolas" FontSize="22" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Résistance de freinage" Style="{StaticResource FieldLabel}" Margin="0" />
                            <TextBlock Text="{Binding BrakeResistor}" FontFamily="Consolas" FontSize="22" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Effacer les erreurs" Command="{Binding ClearErrorsCommand}" />
                        <Button Content="Sauvegarder dans la carte" Command="{Binding SaveConfigurationCommand}" />
                        <Button Content="Redémarrer" Command="{Binding RebootCommand}" />
                        <Button Content="Effacer la configuration…" Command="{Binding EraseConfigurationCommand}"
                                Foreground="{StaticResource Danger}" Margin="0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Erreurs décodées -->
            <Border Style="{StaticResource Card}" Background="{StaticResource DangerBackground}"
                    BorderBrush="{StaticResource Danger}"
                    Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Erreurs" Style="{StaticResource CardTitle}" Foreground="{StaticResource Danger}" />
                    <ItemsControl ItemsSource="{Binding Errors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock>
                                        <Run Text="{Binding Name, Mode=OneWay}" FontFamily="Consolas" FontWeight="Bold" />
                                        <Run Text="  —  " />
                                        <Run Text="{Binding Source, Mode=OneWay}" Foreground="{StaticResource MutedText}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Axes -->
            <ItemsControl ItemsSource="{Binding Axes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                                    <Border DockPanel.Dock="Left" Background="{StaticResource Armed}" CornerRadius="3"
                                            Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsArmed, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="MOTEUR ARMÉ" Foreground="White" FontWeight="Bold" FontSize="11" />
                                    </Border>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="IDLE" Command="{Binding IdleCommand}" />
                                        <Button Content="CLOSED__LOOP" Command="{Binding ClosedLoopCommand}" Margin="0" />
                                    </StackPanel>
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        <RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="État" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentState}" Style="{StaticResource FieldValue}" FontWeight="Bold" />
                                    <TextBlock Grid.Row="1" Text="Mode de contrôle" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ControlMode}" Style="{StaticResource FieldValue}" />
                                    <TextBlock Grid.Row="2" Text="Mode d'entrée" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InputMode}" Style="{StaticResource FieldValue}" />
                                    <TextBlock Grid.Row="3" Text="Consigne" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Setpoint}" Style="{StaticResource FieldValue}" />
                                    <TextBlock Grid.Row="4" Text="Vitesse estimée" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Velocity}" Style="{StaticResource FieldValue}" />
                                    <TextBlock Grid.Row="5" Text="Position estimée" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Position}" Style="{StaticResource FieldValue}" />
                                    <TextBlock Grid.Row="6" Text="Iq mesuré" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding IqMeasured}" Style="{StaticResource FieldValue}" />
                                    <TextBlock Grid.Row="7" Text="Iq consigne" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding IqSetpoint}" Style="{StaticResource FieldValue}" />
                                    <TextBlock Grid.Row="8" Text="Température FET" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding FetTemperature}" Style="{StaticResource FieldValue}" />
                                    <TextBlock Grid.Row="9" Text="Température moteur" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding MotorTemperature}" Style="{StaticResource FieldValue}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
