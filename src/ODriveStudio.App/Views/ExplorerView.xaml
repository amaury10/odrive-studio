<UserControl x:Class="ODriveStudio.App.Views.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ODriveStudio.App.ViewModels">
    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="2*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- Arbre de la carte -->
        <DockPanel Grid.Column="0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Left" Text="Rechercher" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource MutedText}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding MatchSummary}" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{StaticResource MutedText}" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" Padding="4"
                         ToolTip="Recherche dans les chemins et la documentation (plusieurs mots possibles)" />
            </DockPanel>
            <TreeView ItemsSource="{Binding Roots}" VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling" BorderBrush="{StaticResource CardBorder}">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:ExplorerNodeViewModel}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="{Binding Name}" MinWidth="230">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsObject}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFunction}" Value="True">
                                                <Setter Property="FontStyle" Value="Italic" />
                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding CurrentValue}" FontFamily="Consolas" />
                            <TextBlock Text="{Binding Unit}" Foreground="{StaticResource MutedText}" Margin="6,0,0,0" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

        <!-- Détail du nœud sélectionné -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
            <Grid>
                <TextBlock Text="Sélectionner une propriété ou une fonction dans l'arbre."
                           Foreground="{StaticResource MutedText}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNode}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedNode}">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding Path}" FontFamily="Consolas" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Foreground="{StaticResource MutedText}" Margin="0,4,0,10">
                            <Run Text="{Binding TypeName, Mode=OneWay}" />
                            <Run Text="  " />
                            <Run Text="{Binding Access, Mode=OneWay}" />
                        </TextBlock>

                        <!-- Propriété : valeur lue et écriture -->
                        <StackPanel Visibility="{Binding IsProperty, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Valeur sur la carte" Style="{StaticResource FieldLabel}" Margin="0" />
                            <DockPanel Margin="0,2,0,12">
                                <Button DockPanel.Dock="Right" Content="Relire" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
                                <TextBlock VerticalAlignment="Center" FontFamily="Consolas" FontSize="16" TextWrapping="Wrap">
                                    <Run Text="{Binding CurrentValue, Mode=OneWay}" />
                                    <Run Text="{Binding Unit, Mode=OneWay}" Foreground="{StaticResource MutedText}" />
                                </TextBlock>
                            </DockPanel>

                            <StackPanel Visibility="{Binding IsWritable, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Nouvelle valeur" Style="{StaticResource FieldLabel}" Margin="0" />
                                <DockPanel Margin="0,2,0,0">
                                    <Button DockPanel.Dock="Right" Content="Écrire" Command="{Binding ApplyCommand}" Margin="8,0,0,0" IsDefault="False" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" VerticalAlignment="Center"
                                               Margin="6,0,0,0" Foreground="{StaticResource MutedText}" />
                                    <Grid>
                                        <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" Padding="4"
                                                 FontFamily="Consolas"
                                                 Visibility="{Binding HasChoices, Converter={StaticResource InverseBoolToVisibility}}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding ApplyCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <ComboBox ItemsSource="{Binding Choices}" IsEditable="True" FontFamily="Consolas"
                                                  Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                  Visibility="{Binding HasChoices, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Fonction : arguments et appel -->
                        <StackPanel Visibility="{Binding IsFunction, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Arguments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Left" MinWidth="150" VerticalAlignment="Center">
                                                <Run Text="{Binding Name, Mode=OneWay}" FontFamily="Consolas" />
                                                <Run Text="{Binding TypeName, Mode=OneWay}" Foreground="{StaticResource MutedText}" />
                                            </TextBlock>
                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Padding="4" FontFamily="Consolas" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Appeler" Command="{Binding CallCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        </StackPanel>

                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,10,0,0" FontFamily="Consolas"
                                   Foreground="{StaticResource Accent}" />
                        <TextBlock Text="{Binding Documentation}" TextWrapping="Wrap" Margin="0,14,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
