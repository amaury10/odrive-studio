<Application x:Class="ODriveStudio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ODriveStudio.App.ViewModels"
             xmlns:views="clr-namespace:ODriveStudio.App.Views">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <SolidColorBrush x:Key="WindowBackground" Color="#F3F4F6" />
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorder" Color="#D9DCE1" />
        <SolidColorBrush x:Key="HeaderBackground" Color="#1F2933" />
        <SolidColorBrush x:Key="MutedText" Color="#5B6470" />
        <SolidColorBrush x:Key="Accent" Color="#1D6FB8" />
        <SolidColorBrush x:Key="Danger" Color="#C62828" />
        <SolidColorBrush x:Key="DangerBackground" Color="#FDECEA" />
        <SolidColorBrush x:Key="Armed" Color="#D9480F" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="6" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="Margin" Value="0,3,16,3" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExplorerViewModel}">
            <views:ExplorerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CommissioningViewModel}">
            <views:CommissioningView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:JogViewModel}">
            <views:JogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AutotuneViewModel}">
            <views:AutotuneView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
            <views:ProfilesView />
        </DataTemplate>
    </Application.Resources>
</Application>
